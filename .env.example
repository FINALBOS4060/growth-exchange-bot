# Nusxa oling: cp .env.example .env
# Render'da .env kerak emas — Dashboard -> Environment bo'limiga yozing.

# --- Majburiy ---
# Asosiy bot tokeni (@Obuna_2X_bot). Qo'shimcha ishchi botlarni panelda
# (Botlar bo'limi) qo'shasiz — ular ham shu bazaga ulanadi.
TELEGRAM_BOT_TOKEN=
# Admin Telegram ID'lar (vergul bilan). ID ni @userinfobot dan bilib oling
ADMIN_IDS=123456789
# Veb admin panel egasi: email + parol.
# ADMIN_EMAIL berilsa, kirish faqat shu email (yoki "admin") + parol bilan bo'ladi.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=murakkab-parol-yozing

# --- Yangiliklar boti ---
# @Dunyo_Yangiliklari_Texno_bot tokeni. Kanal va jadval /news sahifasida.
NEWS_BOT_TOKEN=
# Gemini API kaliti (post yaratish uchun). Panelda ham kiritish mumkin.
GEMINI_API_KEY=
# Ixtiyoriy: yangilik mavzusi (standart "technology")
# NEWS_RSS_QUERY=technology

# --- Saqlash (Render'da MAJBURIY tavsiya etiladi) ---
# Render free instance'ning diski doimiy emas: fayl har restart/deploy/uxlashda
# o'chib ketadi. Shuning uchun tashqi Postgres ulang (Neon bepul, muddatsiz).
# Format: postgresql://user:parol@host:5432/dbname?sslmode=require
# Bo'sh bo'lsa — lokal fayl rejimi (data/db.json).
DATABASE_URL=
# Ixtiyoriy: lokal fayl manzili (standart ./data/db.json)
# DATA_FILE=

# --- Render free tier ---
# 1 = o'zini /healthz bilan uyg'oq tutadi (15 daqiqalik uxlashdan saqlaydi)
KEEP_ALIVE=1
# Uyg'otish oralig'i (soniya). 600 = 10 daqiqa
KEEP_ALIVE_SEC=600
# Ixtiyoriy: tashqi manzil (RENDER_EXTERNAL_URL avtomatik olinadi)
# APP_URL=https://mening-botim.onrender.com

# --- Lokal ---
# PORT=3000
